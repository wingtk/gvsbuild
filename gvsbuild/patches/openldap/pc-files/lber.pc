# On windows, the prefix is automagically build from the location of the .pc file
prefix=@prefix@
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: lber (OpenLDAP)
Description: OpenLDAP Lightweight ASN.1 Basic Encoding Rules library
URL: https://www.openldap.org
Version: @version@
Cflags: -I${includedir}
Libs: -L${libdir} -lliblber
